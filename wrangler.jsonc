{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peoplecore-r2-probe",
  "main": "local/r2-probe/src/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "peoplecore-local-documents",
      "local_dev": {
        "experimental_s3_credentials": {
          "accessKeyId": "peoplecore-local-access-key",
          "secretAccessKey": "peoplecore-local-secret-key"
        }
      }
    }
  ]
}
